# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build output
/.next/
/out/
next-env.d.ts

# Production build
/build

# Local database files (SQLite dev database is generated by migrations/seed)
*.db
*.db-journal
/prisma/dev.db
/prisma/*.db
/prisma/*.db-journal

# Environment files with secrets
.env
.env.local
.env.*.local
.env.production

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
/coverage

# Uploaded user content (must live in object storage, not the repo)
/public/uploads

# Editor / OS
.DS_Store
.idea
*.swp
.vscode/*
!.vscode/extensions.json

# Private keys / secrets
*.pem
*.key

# Runtime lock files (scheduled task/session locks; regenerated per session)
.claude/*.lock
