# ---------------------------------------------------------------------------
# Copy this file to `.env` for development:  cp .env.example .env
# (`.env` is auto-loaded by BOTH Next.js and the Prisma CLI. `.env.local` also
#  works for Next.js and overrides `.env`. Both are gitignored.)
# NEVER commit real secrets.
# See docs/authentication-and-security.md for where each value comes from.
# ---------------------------------------------------------------------------

# Database connection string.
# DEV (default): SQLite file, no external service required.
DATABASE_URL="file:./dev.db"
# PROD example (PostgreSQL, e.g. Neon/Supabase — change provider in schema.prisma):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Secret used to sign session tokens (Auth.js). REQUIRED.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Public base URL of the app. Used for absolute links and auth callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Trust the host header (needed on some deploy platforms behind a proxy).
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# OPTIONAL — not required for the local MVP. Documented for later phases.
# ---------------------------------------------------------------------------
# Object storage for user-uploaded visual assets (S3-compatible). Phase 2.
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT=

# Email provider for verification / password reset (Phase 2).
# EMAIL_SERVER=
# EMAIL_FROM=

# Error monitoring (Phase 2).
# SENTRY_DSN=
